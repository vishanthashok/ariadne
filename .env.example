# Sentinel Hub / Copernicus (optional — synthetic fallback used if empty)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Mapbox (required for live satellite map tiles in the frontend)
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Region: min_lon,min_lat,max_lon,max_lat (Donetsk Oblast default)
REGION_BBOX=37.5,48.0,38.5,48.8

# Patch / tile settings
TILE_SIZE_PX=256
TILE_RESOLUTION_M=10

# API
API_HOST=0.0.0.0
API_PORT=8000
